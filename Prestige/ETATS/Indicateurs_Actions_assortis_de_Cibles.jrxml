	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["INDICATEURS DES PROGRAMMES ET ACTIONS ASSORTIS DE CIBLES"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_SECTION" class="java.lang.String"/>
	<parameter name="P_VERSION_LIB" class="java.lang.String"/>
	<query language="sql"><![CDATA[select q.*, s.SEC_LIB_LONG
from (
 select distinct
  p.PROG_SEC_NUM,
  p.prog_code as PROG_CODE,
  p.prog_lib as PROG_LIB,
  o.obj_lib as OBJ_LIB,
  i.ind_libelle as IND_LIBELLE,
  i.IND_UNIT_COD,
  v.vlr_annee_reference,
  v.vlr_valeur_reference,
  v.vlr_valeur_realisee,
  v.vlr_valeur_estimee,
  v.vlr_cible_prevue_n1,
  v.vlr_cible_prevue_n2,
  v.vlr_cible_prevue_n3,
  cast(null as varchar2(200)) as STRUCT_RESP
 from vbp_programmes_courant p, vbp_objectif o, vbp_indicateur i, vbp_valeurs v
 where p.prog_code=o.obj_code_code
  and o.obj_code=v.vlr_obj_code
  and i.ind_code=v.vlr_ind_code
  and o.OBJ_TYPE_CODE='OBJPRO'
  and o.OBJ_DATE_FIN is null
  and i.IND_TYPE='INDPRO'
  and v.vlr_exe_exe like CONCAT($P{P_EXERCICE},'%')
  and v.vlr_exe_ver_code like CONCAT($P{P_VERSION},'%')
  and p.PROG_SEC_NUM like CONCAT($P{P_SECTION},'%')
 union
 select distinct
  p.PROG_SEC_NUM,
  a.act_code,
  a.act_lib_court,
  o.obj_lib,
  i.ind_libelle,
  i.IND_UNIT_COD,
  v.vlr_annee_reference,
  v.vlr_valeur_reference,
  v.vlr_valeur_realisee,
  v.vlr_valeur_estimee,
  v.vlr_cible_prevue_n1,
  v.vlr_cible_prevue_n2,
  v.vlr_cible_prevue_n3,
  cast(null as varchar2(200))
 from vbp_action_courante a, vbp_objectif o, vbp_indicateur i, vbp_valeurs v, vbp_programmes_courant p
 where a.ACT_CODE=o.obj_code_code
  and o.obj_code=v.vlr_obj_code
  and i.ind_code=v.vlr_ind_code
  and a.ACT_PROG_CODE=p.PROG_CODE
  and o.OBJ_TYPE_CODE='OBJACT'
  and o.OBJ_DATE_FIN is null
  and i.IND_TYPE='INDACT'
  and v.vlr_exe_exe like CONCAT($P{P_EXERCICE},'%')
  and v.vlr_exe_ver_code like CONCAT($P{P_VERSION},'%')
  and p.PROG_SEC_NUM like CONCAT($P{P_SECTION},'%')
) q
left join vb_section_courante s on s.SEC_NUM=q.PROG_SEC_NUM
order by 1, 2]]></query>
