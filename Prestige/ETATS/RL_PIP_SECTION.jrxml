	<parameter name="gestion" class="java.lang.String"/>
	<parameter name="section" class="java.lang.String"/>
	<parameter name="version" class="java.lang.String"/>
	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["PROGRAMME D'INVESTISSEMENTS PUBLICS (PIP) " + ($P{gestion} == null ? "" : $P{gestion})]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select l.lb_titr_code,
 lb_sec_num,
 SUBSTR(l.LB_IB_CODE,1,4) ACTION,
 SUBSTR(l.LB_IB_CODE,5,13) CHAPITRE,
 SUBSTR(l.LB_IB_CODE,18,4) FONCTION,
 SUBSTR(l.LB_IB_CODE,22,4) SOURCE_FIN,
 lb_ib_code,
 lb_chap_code,
 SUBSTR(lb_nat_code,1,2) ARTICLE,
 SUBSTR(lb_nat_code,3,1) PARAGRAPHE,
 SUBSTR(lb_nat_code,4,3) LIGNE,
 chap_lib,
 lb_montant_final,
 FB_LIBELLE_LONG_SECTION(lb_sec_num) LIB_SECTION
from vb_ligne_budget_dep l, vb_chapitre
where l.LB_EXE_EXE = $P{gestion}
 and l.lb_sec_num like CONCAT($P{section},'%')
 and lb_exe_ver_code = $P{version}
 and lb_chap_code = chap_code
 and nvl(lb_tres_svr,0)+nvl(lb_tres_mn,0)>0
 and l.LB_TITR_CODE=5
 and SUBSTR(l.LB_IB_CODE,22,4) like ('5%')
 and SUBSTR(l.LB_IB_CODE,5,1)=2
order by 2, 3, 4, 5, 6]]></query>
