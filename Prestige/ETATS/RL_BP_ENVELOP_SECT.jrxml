	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["ENVELOPPES PAR SECTION"]]></defaultValueExpression>
	</parameter>
	<parameter name="GESTION" class="java.lang.String"/>
	<parameter name="VERSION" class="java.lang.String"/>
	<parameter name="SECTION" class="java.lang.String"/>
	<query language="sql"><![CDATA[select v.EVS_EXE_EXE, v.EVS_EXE_VER_CODE, v.EVS_TITR_CODE, FB_LIBELLE_TITRE(v.EVS_TITR_CODE) libelle,
 v.EVS_MONTANT_AE, v.EVS_MONTANT_CP, v.EVS_MONTANT_AE1, v.EVS_MONTANT_CP1,
 v.EVS_MONTANT_AE2, v.EVS_MONTANT_CP2, v.EVS_SEC_NUM
from vb_envelop_sect v
where v.EVS_STAT_CODE='EBV'
 and v.EVS_EXE_EXE = $P{GESTION}
 and v.EVS_EXE_VER_CODE = $P{VERSION}
 and v.EVS_SEC_NUM = $P{SECTION}
order by 3]]></query>
