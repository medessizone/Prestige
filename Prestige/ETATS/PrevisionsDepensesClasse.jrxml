	</parameter>
	<query language="SQL"><![CDATA[SELECT
LB_EXE_EXE, 
LB_EXE_VER_CODE, 
LB_SEC_NUM,
FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) LIBELLE_SECTION,
--LB_SEC_DATE_EFFET, 
--LB_TITR_CODE,
--LB_CHAP_CODE, 
--FB_LIBELLE_CHAPITRE(LB_CHAP_CODE),

substr (LB_IB_CODE,18,2) code_Division,
fb_libelle_fonction_prog (substr (LB_IB_CODE,18,2)) Libelle_Division,
substr (LB_IB_CODE,18,3) code_Groupe,
fb_libelle_fonction_prog (substr (LB_IB_CODE,18,3)) Libelle_Groupe,
substr (LB_IB_CODE,18,4) code_Classe,
fb_libelle_fonction_prog (substr (LB_IB_CODE,18,4)) Libelle_Classe,
--LB_NAT_CODE,
--SUBSTR(LB_NAT_CODE,1,2) ARTICLE,
--FB_LIBELLE_NATURE(SUBSTR(LB_NAT_CODE,1,2)),
--LB_IB_CODE,

nvl(sum(LB_MONTANT_FINAL_AE),0)/1000 AE,
nvl(sum(LB_MONTANT_FINAL),0)/1000 CP,
nvl(sum(LB_MONTANT_FINAL_AE1),0)/1000 AE1,
nvl(sum(LB_MONTANT_FINAL_CP1),0)/1000 CP1,
nvl(sum(LB_MONTANT_FINAL_AE2),0)/1000 AE2,
nvl(sum(LB_MONTANT_FINAL_CP2),0)/1000 CP2

FROM VB_LIGNE_BUDGET_DEP 
WHERE lb_exe_exe=$P{P_EXERCICE}
AND lb_exe_ver_code=$P{P_VERSION}
AND LB_SEC_NUM                         LIKE $P{P_SECTION}||'%'
AND substr (LB_IB_CODE,15,2)      LIKE  $P{P_DIVISION}||'%' 
AND substr (LB_IB_CODE,15,3)      LIKE $P{P_GROUPE}||'%' 
and substr(lb_ib_code,5,1)=1

GROUP BY LB_SEC_NUM,LB_EXE_EXE,LB_EXE_VER_CODE,substr (LB_IB_CODE,18,2),substr (LB_IB_CODE,18,3),substr (LB_IB_CODE,18,4)
ORDER BY LB_SEC_NUM,FB_LIBELLE_LONG_SECTION(LB_SEC_NUM),substr (LB_IB_CODE,18,2),substr (LB_IB_CODE,18,3),substr (LB_IB_CODE,18,4)]]></query>
