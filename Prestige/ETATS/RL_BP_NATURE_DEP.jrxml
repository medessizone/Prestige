	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["ETAT DES PREVISIONS DES DEPENSES BUDGETAIRES PAR NATURE ECONOMIQUE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_NATURE" class="java.lang.String"/>
	<query language="sql"><![CDATA[select
 substr(l.LB_NAT_CODE,1,1) CLASSE,
 substr(l.LB_NAT_CODE,1,2) ARTICLE, fb_libelle_nat_eco(substr(l.LB_NAT_CODE,1,2)) LIB_ARTICLE,
 substr(l.LB_NAT_CODE,1,3) PARAGRAPHE, fb_libelle_nat_eco(substr(l.LB_NAT_CODE,1,3)) LIB_PARAGRAPHE,
 substr(l.LB_NAT_CODE,1,6) LIGNE, fb_libelle_nat_eco(substr(l.LB_NAT_CODE,1,6)) LIB_LIGNE,
 NVL(SUM(LB_MONTANT_FINAL_AE),0)/1000 AE,
 NVL(SUM(LB_MONTANT_FINAL),0)/1000 CP,
 NVL(SUM(LB_MONTANT_FINAL_AE1),0)/1000 AE1,
 NVL(SUM(LB_MONTANT_FINAL_CP1),0)/1000 CP1,
 NVL(SUM(LB_MONTANT_FINAL_AE2),0)/1000 AE2,
 NVL(SUM(LB_MONTANT_FINAL_CP2),0)/1000 CP2
from vb_ligne_budget_dep l
where l.LB_EXE_EXE LIKE CONCAT($P{P_EXERCICE},'%')
 and l.LB_EXE_VER_CODE LIKE CONCAT($P{P_VERSION},'%')
 and substr(l.LB_NAT_CODE,1,6) LIKE CONCAT($P{P_NATURE},'%')
 and substr(l.lb_ib_code,5,1)=1
group by substr(l.LB_NAT_CODE,1,1), substr(l.LB_NAT_CODE,1,2),
 substr(l.LB_NAT_CODE,1,3), substr(l.LB_NAT_CODE,1,6)
order by 1, 2, 4, 6]]></query>
