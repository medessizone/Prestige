	<query language="SQL"><![CDATA[----ETAT PAR SECTION,PROGRAMME,GRANDE NATURE
SELECT
LB_EXE_EXE, 
LB_EXE_VER_CODE, 
LB_SEC_NUM,
FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) FB_LIBELLE_LONG_SECTION_LB_SEC,
SUBSTR(LB_IB_CODE,1,3) programme,
fb_libelle_programme(SUBSTR(LB_IB_CODE,1,3)) fb_libelle_programme_SUBSTR_LB,
SUBSTR(LB_IB_CODE,1,4)action,
 fb_libelle_action(SUBSTR(LB_IB_CODE,1,4)) fb_libelle_action_SUBSTR_LB_IB,
 SUBSTR(LB_IB_CODE,5,13) chapitre,
 fb_libelle_chapitre(SUBSTR(LB_IB_CODE,5,13)) fb_libelle_chapitre_SUBSTR_LB_,
 SUBSTR(LB_IB_CODE,1,6) activite,
 fb_libelle_activite(SUBSTR(LB_IB_CODE,1,6)) fb_libelle_activite_SUBSTR_LB_,
----SUBSTR(LB_IB_CODE,22,4) sourcefin,
nvl(SUM(LB_MONTANT_LFI),0) /1000 LB_MONTANT_LFI_CP,
nvl(SUM(LB_MONTANT_LFI_AE) ,0)/1000 LB_MONTANT_LFI_AE, 
nvl(SUM(LB_MONTANT_FINAL) ,0) /1000 LB_MONTANT_FINAL_CP,
nvl(SUM(LB_MONTANT_FINAL_AE),0) /1000 LB_MONTANT_FINAL_AE,
nvl(SUM(LB_MONTANT_FINAL_AE1),0) /1000 LB_MONTANT_FINAL_AE1,
nvl(SUM(LB_MONTANT_FINAL_CP1),0) /1000 LB_MONTANT_FINAL_CP1,
nvl(SUM(LB_MONTANT_FINAL_AE2),0) /1000 LB_MONTANT_FINAL_AE2,
nvl(SUM(LB_MONTANT_FINAL_CP2),0) /1000 LB_MONTANT_FINAL_CP2
FROM VB_LIGNE_BUDGET_DEP 
WHERE ---NVL(LB_MONTANT_FINAL,0)/1000 >0
---and nvl(lb_tres_svr,0)+nvl(lb_tres_mn,0)>0
/*
 lb_exe_exe=2018
and lb_exe_ver_code=1
AND LB_SEC_NUM LIKE 210||'%'
--AND LB_TITR_CODE LIKE :P_titr_code||'%'*/
 lb_exe_exe LIKE $P{P_Exercice}||'%'
and LB_EXE_VER_CODE LIKE $P{P_Version}||'%'
and LB_SEC_NUM LIKE $P{P_Sec_Num}||'%'
and SUBSTR(LB_IB_CODE,1,3)  LIKE $P{P_Programme}||'%'
and SUBSTR(LB_IB_CODE,1,4)  LIKE $P{P_Action}||'%'
and substr(lb_ib_code,5,1)=1
--and LB_TITR_CODE LIKE :P_titr_code||'%'

GROUP BY LB_EXE_EXE,LB_EXE_VER_CODE,LB_SEC_NUM,SUBSTR(LB_IB_CODE,1,3),SUBSTR(LB_IB_CODE,1,4), SUBSTR(LB_IB_CODE,5,13), SUBSTR(LB_IB_CODE,1,6) 
order by LB_SEC_NUM,SUBSTR(LB_IB_CODE,1,3),SUBSTR(LB_IB_CODE,1,4), SUBSTR(LB_IB_CODE,5,13), SUBSTR(LB_IB_CODE,1,6)]]></query>
