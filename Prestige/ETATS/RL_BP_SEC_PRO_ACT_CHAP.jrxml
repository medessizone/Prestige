	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["PREVISION DES DEPENSES PAR SECTION, PAR PROGRAMME, PAR ACTION, ET PAR CHAPITRE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Exercice" class="java.lang.String"/>
	<parameter name="P_Version" class="java.lang.String"/>
	<parameter name="P_Sec_Num" class="java.lang.String"/>
	<parameter name="P_Programme" class="java.lang.String"/>
	<parameter name="P_Action" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
 LB_EXE_EXE,
 LB_EXE_VER_CODE,
 LB_SEC_NUM,
 FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) as LIB_SECTION,
 SUBSTR(LB_IB_CODE,1,3) as PROGRAMME,
 fb_libelle_programme(SUBSTR(LB_IB_CODE,1,3)) as LIB_PROGRAMME,
 SUBSTR(LB_IB_CODE,1,4) as ACTION,
 fb_libelle_action(SUBSTR(LB_IB_CODE,1,4)) as LIB_ACTION,
 SUBSTR(LB_IB_CODE,5,13) as CHAPITRE,
 fb_libelle_chapitre(SUBSTR(LB_IB_CODE,5,13)) as LIB_CHAPITRE,
 SUBSTR(LB_IB_CODE,1,6) as ACTIVITE,
 fb_libelle_activite(SUBSTR(LB_IB_CODE,1,6)) as LIB_ACTIVITE,
 nvl(SUM(LB_MONTANT_LFI),0)/1000 as LB_MONTANT_LFI_CP,
 nvl(SUM(LB_MONTANT_LFI_AE),0)/1000 as LB_MONTANT_LFI_AE,
 nvl(SUM(LB_MONTANT_FINAL),0)/1000 as LB_MONTANT_FINAL_CP,
 nvl(SUM(LB_MONTANT_FINAL_AE),0)/1000 as LB_MONTANT_FINAL_AE,
 nvl(SUM(LB_MONTANT_FINAL_AE1),0)/1000 as LB_MONTANT_FINAL_AE1,
 nvl(SUM(LB_MONTANT_FINAL_CP1),0)/1000 as LB_MONTANT_FINAL_CP1,
 nvl(SUM(LB_MONTANT_FINAL_AE2),0)/1000 as LB_MONTANT_FINAL_AE2,
 nvl(SUM(LB_MONTANT_FINAL_CP2),0)/1000 as LB_MONTANT_FINAL_CP2
FROM VB_LIGNE_BUDGET_DEP
WHERE lb_exe_exe LIKE CONCAT($P{P_Exercice},'%')
 and LB_EXE_VER_CODE LIKE CONCAT($P{P_Version},'%')
 and LB_SEC_NUM LIKE CONCAT($P{P_Sec_Num},'%')
 and SUBSTR(LB_IB_CODE,1,3) LIKE CONCAT($P{P_Programme},'%')
 and SUBSTR(LB_IB_CODE,1,4) LIKE CONCAT($P{P_Action},'%')
 and substr(lb_ib_code,5,1)=1
GROUP BY LB_EXE_EXE, LB_EXE_VER_CODE, LB_SEC_NUM, SUBSTR(LB_IB_CODE,1,3), SUBSTR(LB_IB_CODE,1,4), SUBSTR(LB_IB_CODE,5,13), SUBSTR(LB_IB_CODE,1,6)
ORDER BY 3, 5, 7, 9, 11]]></query>
