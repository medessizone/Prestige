	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["TABLEAU MATRICIEL CROISE DE CLASSIFICATION ADMINISTRATIVE ET ECONOMIQUE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_SECTION" class="java.lang.String"/>
	<parameter name="P_CHAP_CODE" class="java.lang.String"/>
	<parameter name="P_ARTICLE" class="java.lang.String"/>
	<query language="sql"><![CDATA[select
 LB_EXE_EXE,
 LB_EXE_VER_CODE,
 LB_SEC_NUM,
 FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) as LIB_SECTION,
 LB_CHAP_CODE,
 FB_LIBELLE_CHAPITRE(LB_CHAP_CODE) as LIB_CHAPITRE,
 SUBSTR(LB_CHAP_CODE,1,1) as TYPE_BUDGET,
 SUBSTR(LB_CHAP_CODE,2,1) as TYPE_SERVICE,
 SUBSTR(LB_CHAP_CODE,2,2) as CATEGORIE_SCE,
 SUBSTR(LB_CHAP_CODE,4,3) as SITUATION_GEO,
 SUBSTR(LB_NAT_CODE,1,2) as ARTICLE,
 FB_LIBELLE_NATURE(SUBSTR(LB_NAT_CODE,1,2)) as LIB_NATURE,
 nvl(sum(LB_MONTANT_FINAL_AE),0)/1000 as AE,
 nvl(sum(LB_MONTANT_FINAL),0)/1000 as CP,
 nvl(sum(LB_MONTANT_FINAL_AE1),0)/1000 as AE1,
 nvl(sum(LB_MONTANT_FINAL_CP1),0)/1000 as CP1,
 nvl(sum(LB_MONTANT_FINAL_AE2),0)/1000 as AE2,
 nvl(sum(LB_MONTANT_FINAL_CP2),0)/1000 as CP2
from VB_LIGNE_BUDGET_DEP
where lb_exe_exe=$P{P_EXERCICE}
 and LB_exe_ver_code=$P{P_VERSION}
 and LB_SEC_NUM like CONCAT($P{P_SECTION},'%')
 and LB_CHAP_CODE like CONCAT($P{P_CHAP_CODE},'%')
 and SUBSTR(LB_NAT_CODE,1,2) like CONCAT($P{P_ARTICLE},'%')
 and substr(lb_ib_code,5,1)=1
group by LB_EXE_EXE, LB_EXE_VER_CODE, LB_SEC_NUM, LB_CHAP_CODE, SUBSTR(LB_IB_CODE,5,13), SUBSTR(LB_NAT_CODE,1,2)
order by 3, 5, 11]]></query>
