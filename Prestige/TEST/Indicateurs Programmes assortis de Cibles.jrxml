	<style name="Head" style="Cell" mode="Opaque" forecolor="#FFFFFF" backcolor="#041BB0" hTextAlign="Center" vTextAlign="Middle" bold="true"/>
	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["INDICATEURS DE PERFORMANCE DES PROGRAMMES ASSORTIS DE CIBLES"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_SECTION" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT DISTINCT 
  p.PROG_SEC_NUM AS LB_SEC_NUM,
  s.SEC_LIB_LONG,
  p.prog_code AS PROG_CODE,
  p.prog_lib AS PROG_LIB,
  o.obj_lib AS OBJ_LIB,
  i.ind_libelle AS IND_LIBELLE,
  i.IND_UNIT_COD AS IND_UNIT_COD,
  v.vlr_annee_reference AS VLR_ANNEE_REFERENCE,
  v.vlr_valeur_reference AS VLR_VALEUR_REFERENCE,
  v.vlr_valeur_realisee AS VLR_VALEUR_REALISEE,
  v.vlr_valeur_estimee AS VLR_VALEUR_ESTIMEE,
  v.vlr_cible_prevue_n1 AS VLR_CIBLE_PREVUE_N1,
  v.vlr_cible_prevue_n2 AS VLR_CIBLE_PREVUE_N2,
  v.vlr_cible_prevue_n3 AS VLR_CIBLE_PREVUE_N3
FROM vbp_programmes_courant p
JOIN vb_section_courante s ON p.PROG_SEC_NUM = s.SEC_NUM
JOIN vbp_objectif o ON p.prog_code = o.obj_code_code
JOIN vbp_valeurs v ON o.obj_code = v.vlr_obj_code
JOIN vbp_indicateur i ON i.ind_code = v.vlr_ind_code
WHERE o.OBJ_TYPE_CODE = 'OBJPRO'
  AND o.OBJ_DATE_FIN IS NULL
  AND i.IND_TYPE = 'INDPRO'
  AND v.vlr_exe_exe LIKE CONCAT($P{P_EXERCICE}, '%')
  AND v.vlr_exe_ver_code LIKE CONCAT($P{P_VERSION}, '%')
  AND p.PROG_SEC_NUM LIKE CONCAT($P{P_SECTION}, '%')
ORDER BY p.PROG_SEC_NUM, p.prog_code]]></query>
