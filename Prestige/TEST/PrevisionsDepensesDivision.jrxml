	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["ETAT DES PREVISIONS DES DEPENSES PAR FONCTION : DIVISION"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Gestion" class="java.lang.String">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy").format(new java.util.Date())]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Version" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Section" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Division" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="FMT" forPrompting="false" class="java.text.DecimalFormat">
		<defaultValueExpression><![CDATA[new java.text.DecimalFormat("#,##0", new java.text.DecimalFormatSymbols(java.util.Locale.US))]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[select
d.LB_SEC_NUM Code_Section,
s.sec_lib_court Libelle_Section, s.sec_lib_long Libelle_sec_Long,
substr (d.LB_IB_CODE,18,2) code_Division,
fb_libelle_fonction_prog (substr (d.LB_IB_CODE,18,2)) Libelle_Division,

nvl(sum(d.LB_MONTANT_FINAL_AE),0)/1000 AE,
nvl(sum(d.LB_MONTANT_FINAL),0)/1000 CP,
nvl(sum(d.LB_MONTANT_FINAL_AE1),0)/1000 AE1,
nvl(sum(d.LB_MONTANT_FINAL_CP1),0)/1000 CP1,
nvl(sum(d.LB_MONTANT_FINAL_AE2),0)/1000 AE2,
nvl(sum(d.LB_MONTANT_FINAL_CP2),0)/1000 CP2

from vb_ligne_budget_dep d, vb_fonction_prog f,vb_section_courant s

where substr (d.LB_IB_CODE,18,2)=f.fonc_prog_code 
and d.LB_SEC_NUM=s.sec_num
and d.LB_SEC_DATE_EFFET=s.sec_date_effet
and d.LB_EXE_EXE              LIKE $P{P_Gestion}||'%'
and d.LB_EXE_VER_CODE         LIKE $P{P_Version}||'%'
and d.LB_SEC_NUM              LIKE $P{P_Section}||'%'
and substr(d.LB_IB_CODE,18,2) LIKE $P{P_Division}||'%'
and substr(lb_ib_code,5,1)=1
Group by d.LB_SEC_NUM,s.sec_lib_court,s.sec_lib_long,
substr(d.LB_IB_CODE,18,2)
Order by d.LB_SEC_NUM,substr (d.LB_IB_CODE,18,2)]]></query>
