	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["TABLEAU MATRICIEL CROISE DE CLASSIFICATION ADMINISTRATIVE ET ECONOMIQUE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_SECTION" class="java.lang.String"/>
	<parameter name="P_CHAP_CODE" class="java.lang.String"/>
	<parameter name="P_ARTICLE" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
 LB_EXE_EXE,
 LB_EXE_VER_CODE,
 LB_SEC_NUM,
 FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) LIB_SECTION,
 LB_CHAP_CODE,
 FB_LIBELLE_CHAPITRE(LB_CHAP_CODE) LIB_CHAPITRE,
 SUBSTR(LB_CHAP_CODE,1,1) TYPE_BUDGET,
 SUBSTR(LB_CHAP_CODE,2,1) TYPE_SERVICE,
 SUBSTR(LB_CHAP_CODE,2,2) CATEGORIE_SCE,
 SUBSTR(LB_CHAP_CODE,4,3) SITUATION_GEO,
 LB_NAT_CODE, FB_LIBELLE_NAT_ECO(LB_NAT_CODE) LIB_NATURE,
 nvl(sum(LB_MONTANT_FINAL_AE),0)/1000 AE,
 nvl(sum(LB_MONTANT_FINAL),0)/1000 CP,
 nvl(sum(LB_MONTANT_FINAL_AE1),0)/1000 AE1,
 nvl(sum(LB_MONTANT_FINAL_CP1),0)/1000 CP1,
 nvl(sum(LB_MONTANT_FINAL_AE2),0)/1000 AE2,
 nvl(sum(LB_MONTANT_FINAL_CP2),0)/1000 CP2
FROM VB_LIGNE_BUDGET_DEP
WHERE lb_exe_exe = $P{P_EXERCICE}
 AND LB_exe_ver_code = $P{P_VERSION}
 AND LB_SEC_NUM LIKE CONCAT($P{P_SECTION},'%')
 AND LB_CHAP_CODE LIKE CONCAT($P{P_CHAP_CODE},'%')
 AND LB_NAT_CODE LIKE CONCAT($P{P_ARTICLE},'%')
 and substr(lb_ib_code,5,1)=1
GROUP BY LB_EXE_EXE, LB_EXE_VER_CODE, LB_SEC_NUM, LB_CHAP_CODE, SUBSTR(LB_IB_CODE,5,13), LB_NAT_CODE
ORDER BY 3, 5, 11]]></query>
