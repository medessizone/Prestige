	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["ETAT DES PREVISIONS DE DEPENSES BUDGETAIRE PAR GROUPE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXERCICE" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<parameter name="P_SECTION" class="java.lang.String"/>
	<parameter name="P_DIVISION" class="java.lang.String"/>
	<parameter name="P_GROUPE" class="java.lang.String"/>
	<query language="SQL"><![CDATA[
		SELECT
		LB_EXE_EXE, 
		LB_EXE_VER_CODE, 
		LB_SEC_NUM,
		FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) AS LIBELLE_SECTION,
		substr(LB_IB_CODE,18,2) AS code_Division,
		fb_libelle_fonction_prog(substr(LB_IB_CODE,18,2)) AS Libelle_Division,
		substr(LB_IB_CODE,18,3) AS code_Groupe,
		fb_libelle_fonction_prog(substr(LB_IB_CODE,18,3)) AS Libelle_Groupe,
		nvl(sum(LB_MONTANT_FINAL_AE),0)/1000 AS AE,
		nvl(sum(LB_MONTANT_FINAL),0)/1000 AS CP,
		nvl(sum(LB_MONTANT_FINAL_AE1),0)/1000 AS AE1,
		nvl(sum(LB_MONTANT_FINAL_CP1),0)/1000 AS CP1,
		nvl(sum(LB_MONTANT_FINAL_AE2),0)/1000 AS AE2,
		nvl(sum(LB_MONTANT_FINAL_CP2),0)/1000 AS CP2
		FROM VB_LIGNE_BUDGET_DEP 
		WHERE lb_exe_exe = $P{P_EXERCICE}
		AND lb_exe_ver_code = $P{P_VERSION}
		AND LB_SEC_NUM LIKE $P{P_SECTION} || '%'
		AND substr(LB_IB_CODE,18,2) LIKE $P{P_DIVISION} || '%' 
		AND substr(LB_IB_CODE,18,3) LIKE $P{P_GROUPE} || '%' 
		AND substr(lb_ib_code,5,1) = 1
		GROUP BY LB_SEC_NUM, LB_EXE_EXE, LB_EXE_VER_CODE, substr(LB_IB_CODE,18,2), substr(LB_IB_CODE,18,3)
		ORDER BY LB_SEC_NUM, substr(LB_IB_CODE,18,2), substr(LB_IB_CODE,18,3)
	]]></query>
