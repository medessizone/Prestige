	<field name="LIBELLE_SECTION" class="java.lang.String"/>
	<field name="CODE_DIVISION" class="java.lang.String"/>
	<field name="LIBELLE_DIVISION" class="java.lang.String"/>
	<field name="CODE_GROUPE" class="java.lang.String"/>
