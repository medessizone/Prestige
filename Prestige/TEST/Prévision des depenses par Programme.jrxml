	<field name="AE2" class="java.math.BigDecimal"/>
	<field name="CP2" class="java.math.BigDecimal"/>
	<variable name="V_SEC_AE" resetType="Group" calculation="Sum" resetGroup="G_SECTION" class="java.math.BigDecimal">
