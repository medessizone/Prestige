	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["PREVISION DES DEPENSES PAR DOTATION ET PAR PROGRAMME"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EXE_EXE" class="java.lang.String"/>
	<parameter name="P_Vesion" class="java.lang.String"/>
	<parameter name="P_Section" class="java.lang.String"/>
	<parameter name="P_VERSION_LIB" class="java.lang.String"/>
	<query language="sql"><![CDATA[select
 d.LB_EXE_EXE,
 d.LB_EXE_VER_CODE,
 d.LB_SEC_NUM,
 s.SEC_LIB_COURT,
 s.SEC_LIB_LONG,
 substr(d.LB_IB_CODE,1,3) as PROG_CODE,
 p.PROG_LIB,
 nvl(sum(d.LB_MONTANT_FINAL_AE),0)/1000 as AE,
 nvl(sum(d.LB_MONTANT_FINAL),0)/1000 as CP,
 nvl(sum(d.LB_MONTANT_FINAL_AE1),0)/1000 as AE1,
 nvl(sum(d.LB_MONTANT_FINAL_CP1),0)/1000 as CP1,
 nvl(sum(d.LB_MONTANT_FINAL_AE2),0)/1000 as AE2,
 nvl(sum(d.LB_MONTANT_FINAL_CP2),0)/1000 as CP2
from vb_ligne_budget_dep d, vb_section_courante s, vbp_programmes_courant p
where d.LB_SEC_NUM=s.SEC_NUM
 and d.LB_SEC_DATE_EFFET=s.SEC_DATE_EFFET
 and substr(d.LB_IB_CODE,1,3)=p.PROG_CODE
 and d.LB_EXE_EXE like CONCAT($P{P_EXE_EXE},'%')
 and d.LB_EXE_VER_CODE like CONCAT($P{P_Vesion},'%')
 and d.LB_SEC_NUM like CONCAT($P{P_Section},'%')
 and substr(d.LB_IB_CODE,5,1)=1
group by d.LB_EXE_EXE, d.LB_EXE_VER_CODE,
 d.LB_SEC_NUM, s.SEC_LIB_COURT, s.SEC_LIB_LONG,
 substr(d.LB_IB_CODE,1,3), p.PROG_LIB
order by 3, 6]]></query>
