	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["PREVISION DES DEPENSES PAR SECTION ET PAR GRANDE NATURE (CAS)"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_Exercice" class="java.lang.String"/>
	<parameter name="P_Version" class="java.lang.String"/>
	<parameter name="P_Sec_Num" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
 LB_EXE_EXE,
 LB_EXE_VER_CODE,
 LB_SEC_NUM,
 LB_TITR_CODE,
 fb_libelle_titre(LB_TITR_CODE) as LIB_TITRE,
 FB_LIBELLE_LONG_SECTION(LB_SEC_NUM) as LIB_SECTION,
 SUBSTR(LB_IB_CODE,22,1) as FINANCEMENT,
 fb_bp_libelle_type_fin_crt(SUBSTR(LB_IB_CODE,22,1)) as LIBELLE_SF,
 nvl(SUM(LB_MONTANT_LFI),0)/1000 as LB_MONTANT_LFI_CP,
 nvl(SUM(LB_MONTANT_LFI_AE),0)/1000 as LB_MONTANT_LFI_AE,
 nvl(SUM(LB_MONTANT_FINAL),0)/1000 as LB_MONTANT_FINAL_CP,
 nvl(SUM(LB_MONTANT_FINAL_AE),0)/1000 as LB_MONTANT_FINAL_AE,
 nvl(SUM(LB_MONTANT_FINAL_AE1),0)/1000 as LB_MONTANT_FINAL_AE1,
 nvl(SUM(LB_MONTANT_FINAL_CP1),0)/1000 as LB_MONTANT_FINAL_CP1,
 nvl(SUM(LB_MONTANT_FINAL_AE2),0)/1000 as LB_MONTANT_FINAL_AE2,
 nvl(SUM(LB_MONTANT_FINAL_CP2),0)/1000 as LB_MONTANT_FINAL_CP2
FROM VB_LIGNE_BUDGET_DEP
WHERE lb_exe_exe LIKE CONCAT($P{P_Exercice},'%')
 and LB_EXE_VER_CODE LIKE CONCAT($P{P_Version},'%')
 and LB_SEC_NUM LIKE CONCAT($P{P_Sec_Num},'%')
 and substr(lb_ib_code,5,1)=2
GROUP BY LB_EXE_EXE, LB_EXE_VER_CODE, LB_SEC_NUM, LB_TITR_CODE, SUBSTR(LB_IB_CODE,22,1),
 fb_bp_libelle_type_fin_crt(SUBSTR(LB_IB_CODE,22,1))
ORDER BY 3, 4, 7]]></query>
