	<parameter name="TITRE_ETAT" class="java.lang.String">
		<defaultValueExpression><![CDATA["SITUATION RECAPITULATIVE DES REPARTITIONS DES ENVELOPPES PAR GRANDE NATURE"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_GESTION" class="java.lang.String"/>
	<parameter name="P_VERSION" class="java.lang.String"/>
	<query language="sql"><![CDATA[select v.evs_sec_num, v.EVS_SEC_DATE_EFFET, v.EVS_EXE_EXE, v.EVS_TITR_CODE,
 FB_LIBELLE_TITRE(v.EVS_TITR_CODE) libelle,
 FB_LIBELLE_SECTION(v.evs_sec_num, v.EVS_SEC_DATE_EFFET) LIB_SECTION,
 sum(v.EVS_MONTANT_AE) SUM_EVS_MONTANT_AE,
 sum(v.EVS_MONTANT_CP) SUM_EVS_MONTANT_CP,
 sum(v.EVS_MONTANT_AE1) SUM_EVS_MONTANT_AE1,
 sum(v.EVS_MONTANT_CP1) SUM_EVS_MONTANT_CP1,
 sum(v.EVS_MONTANT_AE2) SUM_EVS_MONTANT_AE2,
 sum(v.EVS_MONTANT_CP2) SUM_EVS_MONTANT_CP2
from vb_envelop_sect v
where v.EVS_STAT_CODE='EBT'
 and v.EVS_EXE_EXE = $P{P_GESTION}
 and v.EVS_EXE_VER_CODE = $P{P_VERSION}
group by evs_sec_num, v.EVS_SEC_DATE_EFFET, v.EVS_TITR_CODE, v.EVS_EXE_EXE
order by 1]]></query>
