	<field name="SEC_LIB_LONG" class="java.lang.String"/>
	<field name="PROG_CODE" class="java.lang.String"/>
	<field name="PROG_LIB" class="java.lang.String"/>
	<field name="AE" class="java.math.BigDecimal"/>
	<field name="CP" class="java.math.BigDecimal"/>
	<field name="AE1" class="java.math.BigDecimal"/>
	<field name="CP1" class="java.math.BigDecimal"/>
	<field name="AE2" class="java.math.BigDecimal"/>
	<field name="CP2" class="java.math.BigDecimal"/>
	<variable name="V_SEC_AE" resetType="Group" calculation="Sum" resetGroup="G_SECTION" class="java.math.BigDecimal">
