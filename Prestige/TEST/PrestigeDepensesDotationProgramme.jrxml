	<variable name="V_SEC_AE2" resetType="Group" calculation="Sum" resetGroup="G_SECTION" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AE2}]]></expression>
	</variable>
	<variable name="V_SEC_CP2" resetType="Group" calculation="Sum" resetGroup="G_SECTION" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CP2}]]></expression>
	</variable>
	<variable name="V_TOT_PROG" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[Integer.parseInt($F{PROG_CODE}.trim()) < 800 ? $F{CP} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOT_DOT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[Integer.parseInt($F{PROG_CODE}.trim()) >= 800 && Integer.parseInt($F{PROG_CODE}.trim()) < 900 ? $F{CP} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOT_GLOB" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[Integer.parseInt($F{PROG_CODE}.trim()) >= 900 ? $F{CP} : java.math.BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_TOT_BUDGET" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CP}]]></expression>
	</variable>
